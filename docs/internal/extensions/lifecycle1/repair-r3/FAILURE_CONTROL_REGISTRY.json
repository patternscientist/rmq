    "DP": "docs/internal/extensions/lifecycle-native-p0/repair-r1/dependency_controls.ps1",
    "HS": "docs/internal/extensions/lifecycle-native-p0/repair-r2/harness_stream_controls.ps1"
  },
  "shapes": {
    "P": "intact; the harness succeeds with no integrity difference",
    "C": "a pinned file changes while the stage succeeds; rejected with the integrity difference",
    "Q": "the same change plus an ordinary stage failure; rejected with both recorded",
    "S": "a pinned file is missing at snapshot time; rejected with a durable result written",
    "M": "an exception is raised inside the integrity step (pinned file deleted) while the stage fails; the original stage error is still recorded",
    "X": "the owned-process call itself throws after the evidence directory exists",
    "R": "an owned carrier is left dirty while the stage fails; the carrier check still runs"
  },
  "textSemantics": "Missing-file witnesses use the substring find, common to the .NET and PowerShell 5.1/7 not-found messages. Each stage/integrity entry is a list of groups; every group must be matched by one string value of the durable result (all substrings of the group inside that single value). Values under a pinChecks property are excluded. stageValue is an alternative stage witness: a property with that name and numeric value anywhere in the durable result.",
