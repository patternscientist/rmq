    "FC": "docs/internal/extensions/lifecycle1/repair-r1/finalizer_control.ps1",
    "K1": "docs/internal/extensions/lifecycle1/repair-r1/run_check.ps1",
    "K2": "docs/internal/extensions/lifecycle1/repair-r2/run_check.ps1",
    "DC": "docs/internal/extensions/lifecycle1/repair-r1/dependency_child.ps1",
