    {"id": "selector-malformed", "kind": "selector", "requirement": "REPLAY-SELECTOR-NONVACUITY", "selector": "'Positive Tree!'", "expectedExit": 2, "expectedMarker": "RECEIPT-CONTROLS: SELECTOR-ERROR [malformed]"},
    {"id": "selector-unknown", "kind": "selector", "requirement": "REPLAY-SELECTOR-NONVACUITY", "selector": "no-such-case", "expectedExit": 2, "expectedMarker": "RECEIPT-CONTROLS: SELECTOR-ERROR [unknown]"},
    {"id": "selector-duplicate", "kind": "selector", "requirement": "REPLAY-SELECTOR-NONVACUITY", "selector": "positive-tree,positive-tree", "expectedExit": 2, "expectedMarker": "RECEIPT-CONTROLS: SELECTOR-ERROR [duplicate]"}
