    {"id": "manifest-entry-removed", "kind": "verify-copy", "requirement": "missing manifest entry (additional)", "expectedExit": 1, "expectedCodes": ["archive-extra", "attributes-manifest-mismatch", "manifest-missing-entry"]},
    {"id": "new-result-line-file", "kind": "verify-copy", "requirement": "reintroduced result-line file (additional)", "expectedExit": 1, "expectedCodes": ["new-result-line-file"]},
    {"id": "deadline-descendant-cleanup", "kind": "deadline", "requirement": "REPLAY-SUBPROCESS-DEADLINE", "deadlineSeconds": 5, "expectedExit": null, "expectedCodes": []},
